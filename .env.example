# ========================================================
# RENDER BACKEND ENVIRONMENT VARIABLES
# ========================================================
# Database: SQLite default, or Render PostgreSQL URL
DATABASE_URL=sqlite:///./safecity.db
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# Security & Secrets
SECRET_KEY=super-secret-key-for-dev-safety-system-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# City Demo Coordinates (Raipur, Chhattisgarh)
CITY_NAME=Raipur, Chhattisgarh
CITY_LAT=21.2514
CITY_LON=81.6296
TARGET_RESPONSE_TIME_MIN=10.0

# Optional: Render sets PORT automatically (e.g. 10000)
# PORT=10000

# ========================================================
# VERCEL FRONTEND ENVIRONMENT VARIABLES
# ========================================================
# Set this in Vercel Project Settings -> Environment Variables:
# Example: https://garudabeat-backend.onrender.com/api/v1
VITE_API_BASE_URL=https://your-backend-app.onrender.com/api/v1
